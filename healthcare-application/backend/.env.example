# DORI Backend Environment Configuration (Template)
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dori.db
SECRET_KEY=change-this-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client Origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MedFed ML Services & Inference Integration
MEDFED_MODEL_PATH=../../model-artifacts/best_global_model.pth
MEDFED_REPO_PATH=../../federated-learning
MEDFED_DEVICE=auto
MEDFED_MODEL_NAME=MedFed DenseNet121-CheXNet-14Class
MEDFED_MODEL_VERSION=v1.3 (Fed-FibAvg Global)
MEDFED_MAX_UPLOAD_BYTES=20971520
MEDFED_DATASET_PATH=C:/Users/srinu/Music/fedlearning/DataSET
MEDFED_NODE_ID=hospital-node-01

# Real SMTP Email Dispatch (Server-side ONLY - Never expose to client)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DORI Care Continuity <notifications@dori.gov.in>"
